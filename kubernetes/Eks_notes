## Must-Know Commands

### Cluster
```bash
# Create cluster
eksctl create cluster --name demo-test --region ap-south-1 --version 1.34 --node-type t3.medium --nodes 2 --managed

# Connect kubectl to cluster
aws eks update-kubeconfig --name demo-test --region ap-south-1

# Delete cluster (always delete app first!)
kubectl delete -f deployment.yaml
eksctl delete cluster --name demo-test --region ap-south-1
```

### kubectl Daily Use
```bash
kubectl get nodes                          # are my servers up?
kubectl get pods                           # are my apps running?
kubectl get all                            # see everything
kubectl logs -l app=my-app                 # read app logs
kubectl describe pod <pod-name>            # debug a broken pod
kubectl exec -it <pod-name> -- sh         # get inside a pod
kubectl apply -f file.yaml                 # deploy/update
kubectl delete -f file.yaml                # remove
kubectl scale deployment my-app --replicas=5   # scale up/down
kubectl rollout restart deployment my-app  # redeploy after new image
```

### ECR (Push Image)
```bash
ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
REGISTRY=$ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com

aws ecr create-repository --repository-name my-app --region ap-south-1
aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin $REGISTRY

docker build -t my-app .
docker tag my-app:latest $REGISTRY/my-app:latest
docker push $REGISTRY/my-app:latest
```

### Helm
```bash
helm create my-chart                                   # scaffold a new chart
helm install my-app ./my-chart                         # first deploy
helm upgrade my-app ./my-chart --set image.tag=v2      # update
helm upgrade --install my-app ./my-chart               # install OR update (safe default)
helm rollback my-app 1                                 # rollback to version 1
helm list                                              # list all releases
helm uninstall my-app                                  # remove everything
helm upgrade --install my-app ./my-chart -f values-prod.yaml   # prod deploy
```


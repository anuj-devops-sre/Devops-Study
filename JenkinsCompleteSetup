## Example 2: Multi-Environment Pipeline (Dev → Staging → Prod)

```groovy
pipeline {
    agent any

    environment {
        APP_NAME    = "my-app"
        ECR_REPO    = "123456789.dkr.ecr.ap-south-1.amazonaws.com/my-app"
        IMAGE_TAG   = "${env.BUILD_NUMBER}"
    }

    stages {

        stage('Build & Test') {
            steps {
                sh 'npm ci && npm test'
                sh """
                    docker build -t ${ECR_REPO}:${IMAGE_TAG} .
                    docker push ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy to Dev') {
            steps {
                sh """
                    helm upgrade --install ${APP_NAME} ./helm-chart \
                      -f values-dev.yaml \
                      --set image.tag=${IMAGE_TAG} \
                      --namespace dev
                """
            }
        }

        stage('Deploy to Staging') {
            when {
                branch 'main'
            }
            steps {
                sh """
                    helm upgrade --install ${APP_NAME} ./helm-chart \
                      -f values-staging.yaml \
                      --set image.tag=${IMAGE_TAG} \
                      --namespace staging
                """
            }
        }

        stage('Approval for Production') {
            when {
                branch 'main'
            }
            steps {
                // Manual approval gate — koi click karega tab hi prod deploy hoga
                input message: "Deploy to Production?",
                      ok: "Yes, Deploy!",
                      submitter: "admin,lead-dev"   // sirf ye log approve kar sakte hain
            }
        }

        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                sh """
                    helm upgrade --install ${APP_NAME} ./helm-chart \
                      -f values-prod.yaml \
                      --set image.tag=${IMAGE_TAG} \
                      --namespace production
                """
            }
        }
    }
}
```


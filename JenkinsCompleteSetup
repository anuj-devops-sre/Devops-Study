## Option C — Kubernetes (Helm) par install

```bash
# Jenkins Helm chart install
helm repo add jenkins https://charts.jenkins.io
helm repo update

# values.yaml customize karo (optional)
cat > jenkins-values.yaml << EOF
controller:
  serviceType: LoadBalancer
  resources:
    requests:
      cpu: "500m"
      memory: "512Mi"
    limits:
      cpu: "1000m"
      memory: "2Gi"
  installPlugins:
    - kubernetes:latest
    - workflow-aggregator:latest
    - git:latest
    - docker-workflow:latest
    - aws-credentials:latest
persistence:
  enabled: true
  size: 20Gi
EOF

helm install jenkins jenkins/jenkins \
  --namespace jenkins \
  --create-namespace \
  -f jenkins-values.yaml

# Admin password lao
kubectl exec -n jenkins -it \
  $(kubectl get pod -n jenkins -l app.kubernetes.io/name=jenkins -o name) \
  -- /bin/cat /run/secrets/additional/chart-admin-password
```


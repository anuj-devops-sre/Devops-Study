# PART 11 — Complete Real-World Pipeline

---

Full production-grade pipeline — build se leke deploy tak sab kuch:

```groovy
@Library('my-shared-lib') _

pipeline {
    agent any

    environment {
        APP_NAME     = "my-app"
        ECR_REGISTRY = "123456789.dkr.ecr.ap-south-1.amazonaws.com"
        ECR_REPO     = "${ECR_REGISTRY}/${APP_NAME}"
        IMAGE_TAG    = "${env.GIT_COMMIT[0..7]}"
        AWS_REGION   = "ap-south-1"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
        timestamps()
    }

    stages {
        stage('🔍 Checkout') {
            steps {
                checkout scm
                sh 'git log --oneline -3'
            }
        }

        stage('📦 Install') {
            steps {
                sh 'npm ci'
            }
        }

        stage('🧪 Test + Lint + Scan') {
            parallel {
                stage('Unit Tests') {
                    steps { sh 'npm test' }
                }
                stage('Lint') {
                    steps { sh 'npm run lint' }
                }
                stage('Security Scan') {
                    steps {
                        sh """
                            docker build -t ${ECR_REPO}:scan-${IMAGE_TAG} .
                            trivy image --severity HIGH,CRITICAL \
                              --exit-code 1 \
                              ${ECR_REPO}:scan-${IMAGE_TAG} || true
                        """
                    }
                }
            }
        }

        stage('🐳 Build Image') {
            steps {
                sh "docker build -t ${ECR_REPO}:${IMAGE_TAG} ."
            }
        }

        stage('📤 Push to ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        docker push ${ECR_REPO}:${IMAGE_TAG}
                        docker tag ${ECR_REPO}:${IMAGE_TAG} ${ECR_REPO}:latest
                        docker push ${ECR_REPO}:latest
                    """
                }
            }
        }

        stage('🚀 Deploy Staging') {
            when { branch 'main' }
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                        helm upgrade --install ${APP_NAME} ./helm-chart \
                          -f values-staging.yaml \
                          --set image.tag=${IMAGE_TAG} \
                          --namespace staging --wait
                    """
                }
            }
        }

        stage('✅ Approve Production') {
            when { branch 'main' }
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    input message: "Deploy ${IMAGE_TAG} to Production?", ok: "Deploy!"
                }
            }
        }

        stage('🏁 Deploy Production') {
            when { branch 'main' }
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                        helm upgrade --install ${APP_NAME} ./helm-chart \
                          -f values-prod.yaml \
                          --set image.tag=${IMAGE_TAG} \
                          --namespace production --wait
                        kubectl rollout status deployment/${APP_NAME} \
                          -n production --timeout=5m
                    """
                }
            }
        }
    }

    post {
        success {
            slackNotify('SUCCESS', env.APP_NAME, env.BUILD_NUMBER)
        }
        failure {
            slackNotify('FAILURE', env.APP_NAME, env.BUILD_NUMBER)
        }
        always {
            cleanWs()
            sh 'docker image prune -f'
        }
    }
}
```


## Basic Pipeline Structure

```groovy
pipeline {
    agent any          // kahan run karo — any available agent

    environment {
        // variables jo poore pipeline mein use honge
        APP_NAME = "my-app"
        ECR_REGISTRY = "123456789.dkr.ecr.ap-south-1.amazonaws.com"
        IMAGE_TAG = "${env.BUILD_NUMBER}"   // auto-increment build number
        AWS_REGION = "ap-south-1"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')   // 30 min se zyada chalega toh kill
        disableConcurrentBuilds()             // ek time par ek hi build
        buildDiscarder(logRotator(numToKeepStr: '10'))  // sirf 10 builds rakho
    }

    stages {
        stage('Stage Name') {
            steps {
                // yahan commands likhte hain
            }
        }
    }

    post {
        success { /* success par kya karo */ }
        failure { /* failure par kya karo */ }
        always  { /* hamesha karo (cleanup) */ }
    }
}
```

